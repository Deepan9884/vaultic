PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vaultic
# REQUIRED in production: long random string. Boot refuses to start without it.
JWT_SECRET=changeme
JWT_EXPIRES_IN=1h
# Comma-separated allowed frontend origins (CORS).
CLIENT_URL=http://localhost:5173
# local = Xenova MiniLM (free, on-device) | hash = offline fallback (testing)
EMBEDDING_PROVIDER=local
# Optional: enables generative "Ask Vaultic" answers (Gemini) over retrieved passages.
# Without it, Ask falls back to cited extracts (no key needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional: required only if you want to create an admin via signup
# ADMIN_SECRET=vaultic-admin-secret
